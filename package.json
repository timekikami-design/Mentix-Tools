{
  "name": "mentix-tools",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev --hostname 0.0.0.0 --port 3000",
    "build": "next build",
    "preview": "serve out -l tcp://0.0.0.0:3000",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "prebuild": "node scripts/copy-assets.mjs",
    "test:e2e": "playwright test",
    "format": "prettier --write app components lib tests *.ts *.json *.cjs *.js"
  },
  "dependencies": {
    "browser-image-compression": "^2.0.2",
    "crypto-js": "^4.2.0",
    "dompurify": "^3.2.0",
    "jszip": "^3.10.1",
    "lucide-react": "^0.468.0",
    "marked": "^15.0.0",
    "next": "^15.5.0",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^4.10.38",
    "qrcode": "^1.5.4",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "syllable": "^5.0.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.50.0",
    "@types/crypto-js": "^4.2.2",
    "@types/node": "^22.0.0",
    "@types/qrcode": "^1.5.5",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.5.23",
    "prettier": "^3.9.10",
    "serve": "^14.2.4",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0"
  },
  "overrides": {
    "postcss": "^8.5.23",
    "compression": "^1.8.2"
  }
}
